DATABASE_URL=sqlite:///./student_mental_health.db
# For PostgreSQL, use a value like:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/student_mental_health

JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# NLP Motivational Support Configuration (Optional external AI service)
# When GEMINI_API_KEY is provided, live generative responses are produced using Gemini.
# If not configured, the service seamlessly uses the built-in empathetic offline motivational synthesizer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
